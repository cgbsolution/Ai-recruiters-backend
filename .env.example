DATABASE_URL=postgresql+psycopg://postgres:<db-password>@localhost:5432/ai_recruiters
ANTHROPIC_API_KEY=<your-anthropic-api-key>
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPLOAD_DIR=uploads/jd
MAX_UPLOAD_SIZE_MB=10
# Set to "production" on the live server: it also turns off /docs, /redoc and /openapi.json.
APP_ENV=development
# At least 32 random characters in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here
# Optional separate HMAC keys (derived from SECRET_KEY when empty):
# MEDIA_SIGNING_KEY=
# URL_REF_KEY=
# Set to false once DEEPGRAM_API_KEY can mint short-lived grant tokens (Member role),
# so the permanent key is never sent to a candidate's browser.
# DEEPGRAM_ALLOW_MASTER_KEY_FALLBACK=true

# ── Code execution sandbox (Piston) ──────────────────────────────────────────
# When running via docker-compose, the backend reaches the `piston` service
# at http://piston:2000/api/v2 — already set in docker-compose.yml.
# For local dev without docker-compose, run Piston on your host:
#   docker run -d --name piston -p 2000:2000 ghcr.io/engineer-man/piston
# and uncomment:
# PISTON_API_URL=http://localhost:2000/api/v2
#
# Only needed if you're on Piston's whitelisted public API.
# PISTON_API_KEY=

# ── Judge0 CE fallback (optional) ────────────────────────────────────────────
# If Piston is unreachable (HTTP 401/whitelist, network error), the sandbox
# automatically falls back to Judge0 CE on RapidAPI when this key is set.
# Free tier: 50 executions/day. Sign up: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_RAPIDAPI_KEY=
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
