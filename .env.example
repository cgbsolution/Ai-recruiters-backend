# ── Code execution sandbox (Piston) ──────────────────────────────────────────
# When running via docker-compose, the backend reaches the `piston` service
# at http://piston:2000/api/v2 — already set in docker-compose.yml.
# For local dev without docker-compose, run Piston on your host:
#   docker run -d --name piston -p 2000:2000 ghcr.io/engineer-man/piston
# and uncomment:
# PISTON_API_URL=http://localhost:2000/api/v2
#
# Only needed if you're on Piston's whitelisted public API.
# PISTON_API_KEY=

# ── Judge0 CE fallback (optional) ────────────────────────────────────────────
# If Piston is unreachable (HTTP 401/whitelist, network error), the sandbox
# automatically falls back to Judge0 CE on RapidAPI when this key is set.
# Free tier: 50 executions/day. Sign up: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_RAPIDAPI_KEY=
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
